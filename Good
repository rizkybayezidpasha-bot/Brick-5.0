ExecuteBtn.MouseButton1Click:Connect(function()
    local code = Input.Text
    local func, err = loadstring(code)
    if not func then
        ShowNotification("❌ Syntax Error!", Color3.fromRGB(180, 40, 70))
        warn(err)
        return
    end

    local success, runtimeErr = pcall(func)
    if success then
        ShowNotification("⚡ Executed Successfully!", Color3.fromRGB(40, 150, 80))
    else
        ShowNotification("⚠️ Runtime Error!", Color3.fromRGB(180, 120, 40))
        warn(runtimeErr)
    end
end)

