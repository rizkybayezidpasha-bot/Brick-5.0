local FOLDER_NAME = "AdminExecutor_Workspace/"
if makefolder then makefolder(FOLDER_NAME) end
local savedScripts = {}

local function refreshSaveList()
    for _, child in pairs(SaveList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local count = 0
    for name, code in pairs(savedScripts) do
        count = count + 1
        local itemFrame = Instance.new("Frame")
        itemFrame.Size = UDim2.new(1, -4, 0, 22)
        itemFrame.BackgroundColor3 = Color3.fromRGB(30, 22, 48)
        itemFrame.BackgroundTransparency = 0.3
        itemFrame.BorderSizePixel = 0
        itemFrame.Parent = SaveList

        local itemCorner = Instance.new("UICorner")
        itemCorner.CornerRadius = UDim.new(0, 3)
        itemCorner.Parent = itemFrame

        local loadBtn = Instance.new("TextButton")
        loadBtn.Size = UDim2.new(0.75, 0, 1, 0)
        loadBtn.BackgroundTransparency = 1
        loadBtn.Font = Enum.Font.GothamSemibold
        loadBtn.Text = "  " .. name
        loadBtn.TextColor3 = Color3.fromRGB(220, 200, 255)
        loadBtn.TextSize = 10
        loadBtn.TextXAlignment = Enum.TextXAlignment.Left
        loadBtn.Parent = itemFrame

        loadBtn.MouseButton1Click:Connect(function()
            Input.Text = code
            SaveNameBox.Text = name
            ShowNotification("📂 Loaded: " .. name, Color3.fromRGB(40, 100, 180))
        end)

        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0.22, 0, 0.8, 0)
        delBtn.Position = UDim2.new(0.76, 0, 0.1, 0)
        delBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 70)
        delBtn.BorderSizePixel = 0
        delBtn.Font = Enum.Font.GothamBold
        delBtn.Text = "X"
        delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        delBtn.TextSize = 9
        delBtn.Parent = itemFrame

        local delCorner = Instance.new("UICorner")
        delCorner.CornerRadius = UDim.new(0, 3)
        delCorner.Parent = delBtn

        delBtn.MouseButton1Click:Connect(function()
            savedScripts[name] = nil
            if delfile then pcall(delfile, FOLDER_NAME .. name .. ".lua") end
            refreshSaveList()
            ShowNotification("🗑️ Deleted: " .. name, Color3.fromRGB(180, 40, 70))
        end)
    end
    SaveList.CanvasSize = UDim2.new(0, 0, 0, count * 25)
end

if listfiles and readfile then
    local success, files = pcall(listfiles, FOLDER_NAME)
    if success then
        for _, path in pairs(files) do
            local fileName = path:match("([^/]+)%.lua$") or path:match("([^\\]+)%.lua$")
            if fileName then savedScripts[fileName] = readfile(path) end
        end
    end
end
refreshSaveList()

SaveBtn.MouseButton1Click:Connect(function()
    local name = SaveNameBox.Text
    local code = Input.Text
    if name ~= "" and code ~= "" then
        savedScripts[name] = code
        if writefile then pcall(writefile, FOLDER_NAME .. name .. ".lua", code) end
        refreshSaveList()
        ShowNotification("💾 Saved permanently!", Color3.fromRGB(40, 150, 80))
    else
        ShowNotification("⚠️ Name/Script empty!", Color3.fromRGB(180, 120, 40))
    end
end)

